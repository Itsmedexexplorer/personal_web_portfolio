# Studio login (generate with: npm run setup-studio)
ADMIN_PASSWORD_HASH=
ADMIN_SECRET_KEY=
SESSION_SECRET=
# Optional authenticator-app 2FA
ADMIN_TOTP_SECRET=

# Content + uploads storage. Created automatically when you connect a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional: raises the GitHub API rate limit for the "currently building" pill
GITHUB_TOKEN=

# Search engines: paste the verification code from Search Console / Bing Webmaster (HTML tag method)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
